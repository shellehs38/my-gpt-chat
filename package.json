    "pretest": "npm run memory:export",
    "predev": "npm run memory:export"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "next": "15.5.28",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "postcss": "8.5.30"
  }
