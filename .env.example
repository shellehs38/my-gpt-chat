# Server secrets. Never commit a populated .env file or use NEXT_PUBLIC_ for these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Personal assistant access. Both are required; missing settings keep the API closed.
# Use a unique password of at least 12 characters.
ASSISTANT_ACCESS_PASSWORD=
# Generate independently, e.g.: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
ASSISTANT_SESSION_SECRET=

# Optional canonical HTTPS origin when a reverse proxy changes scheme/Host.
# Example format: https://your-assistant.example (no trailing path).
ASSISTANT_PUBLIC_ORIGIN=
