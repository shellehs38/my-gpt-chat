# Server secrets. Never commit a populated .env file or use NEXT_PUBLIC_ for these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Personal assistant access. Both are required; missing settings keep the API closed.
# Use a unique password of at least 12 characters.
ASSISTANT_ACCESS_PASSWORD=
# Generate independently, e.g.: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
ASSISTANT_SESSION_SECRET=

# Optional canonical HTTPS origin when a reverse proxy changes scheme/Host.
# Example format: https://your-assistant.example (no trailing path).
ASSISTANT_PUBLIC_ORIGIN=

# Website ledger: Google service account JSON, stored only as a server secret.
# Share the selected spreadsheet with its client_email as Editor.
# Never paste the JSON into chat or place it in NEXT_PUBLIC_* variables.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=1-frD3ABf1G-IH1cd31Fktb9NY2XPLg05VGLOwSsgA2U

# Verified connector UID or scl_ ID copied from Vercel Connect (not a Google client ID or secret).
# Link this exact connector to the consuming project/environment first.
# Example only: google/your-verified-connector-name. No guessed/default UID.
GOOGLE_DRIVE_CONNECTOR_UID=
